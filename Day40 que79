#include<stdio.h>
int main()
{
int a[10][10],i,j,r,c;
printf("enter rows and columns");
scanf("%d%d",&r,&c);
printf("enter matrix element");
for(i=0;i<r;i++)
  for(j=0;j<c;j++)
    scanf("%d",&a[i][j]);
printf("diagonal traversal");
for(i=0;i<r;i++)
  for(j=0;j<c;j++)
    if(i==j)
      printf("%d",a[i][j]);
return 0;
}
